# Create a private Telegram bot via @BotFather, then send /start to it.
TELEGRAM_BOT_TOKEN=REPLACE_BOT_TOKEN
# Chat ID for the private chat where preview video should arrive:
TELEGRAM_CHAT_ID=REPLACE_CHAT_ID
# Numeric Telegram user ID of the ONLY permitted approver:
TELEGRAM_APPROVER_USER_ID=REPLACE_USER_ID
KOKORO_MODEL=/files/voices/kokoro-v1.0.onnx
KOKORO_VOICES=/files/voices/voices-v1.0.bin
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
# Optional host paths; use D:/shorts_plus_local/voices if C: is low on space.
KOKORO_ASSETS_DIR=./data/voices
VIDEO_PREVIEWS_DIR=./data/previews
JOBS_DIR=/files/jobs
